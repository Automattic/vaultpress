{
    "packages": [
        {
            "name": "automattic/jetpack-autoloader",
            "version": "5.0.13",
            "version_normalized": "5.0.13.0",
            "dist": {
                "type": "path",
                "url": "/tmp/jetpack-build/Automattic/jetpack-autoloader",
                "reference": "96c80646fa7561c387c8ad3403086d89a5edb63d"
            },
            "require": {
                "composer-plugin-api": "^2.2",
                "php": ">=7.2"
            },
            "require-dev": {
                "automattic/jetpack-changelogger": "^6.0.11-alpha",
                "automattic/phpunit-select-config": "^1.0.3",
                "composer/composer": "^2.2",
                "yoast/phpunit-polyfills": "^4.0.0"
            },
            "type": "composer-plugin",
            "extra": {
                "autotagger": true,
                "class": "Automattic\\Jetpack\\Autoloader\\CustomAutoloaderPlugin",
                "mirror-repo": "Automattic/jetpack-autoloader",
                "changelogger": {
                    "link-template": "https://github.com/Automattic/jetpack-autoloader/compare/v${old}...v${new}"
                },
                "version-constants": {
                    "::VERSION": "src/AutoloadGenerator.php"
                },
                "branch-alias": {
                    "dev-trunk": "5.0.x-dev"
                }
            },
            "installation-source": "dist",
            "autoload": {
                "classmap": [
                    "src/AutoloadGenerator.php"
                ],
                "psr-4": {
                    "Automattic\\Jetpack\\Autoloader\\": "src"
                }
            },
            "scripts": {
                "phpunit": [
                    "phpunit-select-config phpunit.#.xml.dist --colors=always"
                ],
                "test-coverage": [
                    "php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"./tests/php/tmp/coverage-report.php\"",
                    "php ./tests/php/bin/test-coverage.php \"$COVERAGE_DIR/php.cov\""
                ],
                "test-php": [
                    "@composer phpunit"
                ]
            },
            "license": [
                "GPL-2.0-or-later"
            ],
            "description": "Creates a custom autoloader for a plugin or theme.",
            "keywords": [
                "autoload",
                "autoloader",
                "composer",
                "jetpack",
                "plugin",
                "wordpress"
            ],
            "transport-options": {
                "relative": false
            },
            "install-path": "../automattic/jetpack-autoloader"
        },
        {
            "name": "automattic/jetpack-logo",
            "version": "3.0.5",
            "version_normalized": "3.0.5.0",
            "dist": {
                "type": "path",
                "url": "/tmp/jetpack-build/Automattic/jetpack-logo",
                "reference": "444bc43b0edb0073d03e94a08605b23719d4e896"
            },
            "require": {
                "php": ">=7.2"
            },
            "require-dev": {
                "automattic/jetpack-changelogger": "^6.0.11-alpha",
                "automattic/phpunit-select-config": "^1.0.3",
                "yoast/phpunit-polyfills": "^4.0.0"
            },
            "suggest": {
                "automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
            },
            "type": "jetpack-library",
            "extra": {
                "autotagger": true,
                "mirror-repo": "Automattic/jetpack-logo",
                "changelogger": {
                    "link-template": "https://github.com/Automattic/jetpack-logo/compare/v${old}...v${new}"
                },
                "branch-alias": {
                    "dev-trunk": "3.0.x-dev"
                }
            },
            "installation-source": "dist",
            "autoload": {
                "classmap": [
                    "src/"
                ]
            },
            "scripts": {
                "phpunit": [
                    "phpunit-select-config phpunit.#.xml.dist --colors=always"
                ],
                "test-coverage": [
                    "php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
                ],
                "test-php": [
                    "@composer phpunit"
                ]
            },
            "license": [
                "GPL-2.0-or-later"
            ],
            "description": "A logo for Jetpack",
            "transport-options": {
                "relative": false
            },
            "install-path": "../automattic/jetpack-logo"
        }
    ],
    "dev": false,
    "dev-package-names": []
}
